{
  "manifest_version": 3,
  "name": "Barelink",
  "version": "0.2.2",
  "description": "Removes tracking parameters from the links you copy, share or open on social media, so you share the bare link.",
  "permissions": [
    "declarativeNetRequest"
  ],
  "host_permissions": [
    "https://*.x.com/*",
    "https://*.twitter.com/*",
    "https://*.youtube.com/*",
    "https://*.youtu.be/*",
    "https://*.reddit.com/*",
    "https://*.redd.it/*",
    "https://*.facebook.com/*",
    "https://*.fb.watch/*",
    "https://*.instagram.com/*",
    "https://*.threads.net/*",
    "https://*.threads.com/*",
    "https://*.bsky.app/*"
  ],
  "declarative_net_request": {
    "rule_resources": [
      {
        "id": "strip_x",
        "enabled": true,
        "path": "rules.json"
      }
    ]
  },
  "content_scripts": [
    {
      "matches": [
        "https://*.x.com/*",
        "https://*.twitter.com/*",
        "https://*.youtube.com/*",
        "https://*.youtu.be/*",
        "https://*.reddit.com/*",
        "https://*.redd.it/*",
        "https://*.facebook.com/*",
        "https://*.fb.watch/*",
        "https://*.instagram.com/*",
        "https://*.threads.net/*",
        "https://*.threads.com/*",
        "https://*.bsky.app/*"
      ],
      "js": [
        "clean.js",
        "content.js"
      ],
      "run_at": "document_start",
      "world": "MAIN"
    }
  ],
  "icons": {
    "16": "icons/icon-16.png",
    "32": "icons/icon-32.png",
    "48": "icons/icon-48.png",
    "128": "icons/icon-128.png"
  },
  "action": {
    "default_icon": {
      "16": "icons/icon-16.png",
      "32": "icons/icon-32.png",
      "48": "icons/icon-48.png",
      "128": "icons/icon-128.png"
    },
    "default_title": "Barelink"
  }
}
